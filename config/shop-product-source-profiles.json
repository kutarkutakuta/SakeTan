[
  {
    "name": "motimoti-sake-catalog",
    "host": "motimoti.com",
    "pathPrefix": "/",
    "selector": ".col3Con h2 a",
    "canonicalizeBrandPrefix": true,
    "maxPages": 100
  },
  {
    "name": "nakakyu-brand-list",
    "host": "www.nakakyu-honten.com",
    "pathPrefix": "/sake/",
    "itemContainerSelector": ".sakedetailinner04",
    "brandSelector": "ul > li:not(:first-child)",
    "brewerySelector": "ul > li:first-child p:last-child",
    "maxPages": 1
  },
  {
    "name": "morinoya-nihonshu",
    "host": "www.morinoya.com",
    "pathPrefix": "/category/nihonshu",
    "itemContainerSelector": "article.category-nihonshu",
    "brandSelector": "#moji-1",
    "brewerySelector": ".mojimo p",
    "breweryPattern": "(?:北海道|青森県|岩手県|宮城県|秋田県|山形県|福島県|茨城県|栃木県|群馬県|埼玉県|千葉県|東京都|神奈川県|新潟県|富山県|石川県|福井県|山梨県|長野県|岐阜県|静岡県|愛知県|三重県|滋賀県|京都府|大阪府|兵庫県|奈良県|和歌山県|鳥取県|島根県|岡山県|広島県|山口県|徳島県|香川県|愛媛県|高知県|福岡県|佐賀県|長崎県|熊本県|大分県|宮崎県|鹿児島県|沖縄県)[\\s　]+([^\\r\\n…。]+)",
    "canonicalizeBrandPrefix": true,
    "maxPages": 50,
    "ignoreNamePatterns": [
      "入荷",
      "お知らせ",
      "御連絡",
      "ご連絡",
      "発売予定",
      "蔵元応援",
      "特集"
    ]
  },
  {
    "name": "kaneni-nihonshu-brand-table",
    "host": "kaneni-shouji.co.jp",
    "pathPrefix": "/brand/",
    "itemContainerSelector": ".brandlist > .c-tabBody > .c-tabBody__item:first-child tbody tr",
    "brandSelector": "td:nth-child(2)",
    "brandSplitPattern": "[、,，]",
    "brewerySelector": "td:first-child",
    "maxPages": 1
  },
  {
    "name": "stores-category-navigation",
    "hostSuffix": ".stores.jp",
    "pathPrefix": "/",
    "maxPages": 50,
    "ignoreNamePatterns": [
      "味醂",
      "みりん",
      "焼酎",
      "ワイン",
      "ビール",
      "リキュール"
    ]
  }
]
